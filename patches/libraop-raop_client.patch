Music Assistant changes to libraop's src/raop_client.c, against the pinned
submodule commit. The build applies this to a copy of the file (see the
Makefile).

Metadata and artwork sent before the first frame are stamped on the
stream's RTP timeline, with the head that frame will carry (the commanded
start, or now), instead of 0. Receivers that hold metadata until playback
reaches its rtptime (Bose) would otherwise miss it.

The RTP threads are told to stop before they are joined. Joined while their
loop flag is still set, they never end and a disconnect hangs
(philippe44/libraop#61).

diff --git a/src/raop_client.c b/src/raop_client.c
index 446fbee..cc9ea76 100644
--- a/src/raop_client.c
+++ b/src/raop_client.c
@@ -739,11 +739,15 @@ struct raopcl_s *raopcl_create(struct in_addr host, uint16_t port_base, uint16_t
 static void _raopcl_terminate_rtp(struct raopcl_s *p)
 {
 	// Terminate RTP threads and close sockets
-	if (p->ctrl_running) pthread_join(p->ctrl_thread, NULL);
-	p->ctrl_running = false;
+	if (p->ctrl_running) {
+		p->ctrl_running = false;
+		pthread_join(p->ctrl_thread, NULL);
+	}
 
-	if (p->time_running) pthread_join(p->time_thread, NULL);
-	p->time_running = false;
+	if (p->time_running) {
+		p->time_running = false;
+		pthread_join(p->time_thread, NULL);
+	}
 
 	if (p->rtp_ports.ctrl.fd != -1) closesocket(p->rtp_ports.ctrl.fd);
 	if (p->rtp_ports.time.fd != -1) closesocket(p->rtp_ports.time.fd);
@@ -817,12 +821,23 @@ uint64_t raopcl_get_progress_ms(struct raopcl_s* p)
 	return elapsed;
 }
 
+/*----------------------------------------------------------------------------*/
+static uint32_t _raopcl_metadata_ts(struct raopcl_s *p)
+{
+	uint64_t head_ts = p->head_ts;
+
+	// head_ts is set by the first frame, so before it use the one that frame will carry
+	if (!head_ts) head_ts = p->start_ts ? p->start_ts : NTP2TS(raopcl_get_ntp(NULL), p->sample_rate);
+
+	return head_ts + p->latency_frames;
+}
+
 /*----------------------------------------------------------------------------*/
 bool raopcl_set_artwork(struct raopcl_s *p, char *content_type, int size, char *image)
 {
 	if (!p || !p->rtspcl || p->state < RAOP_FLUSHED || !(p->md_caps & MD_ARTWORK)) return false;
 
-	return rtspcl_set_artwork(p->rtspcl, p->head_ts + p->latency_frames, content_type, size, image);
+	return rtspcl_set_artwork(p->rtspcl, _raopcl_metadata_ts(p), content_type, size, image);
 }
 
 /*----------------------------------------------------------------------------*/
@@ -834,7 +849,7 @@ bool raopcl_set_daap(struct raopcl_s *p, int count, ...)
 
 	va_start(args, count);
 
-	return rtspcl_set_daap(p->rtspcl, p->head_ts + p->latency_frames, count, args);
+	return rtspcl_set_daap(p->rtspcl, _raopcl_metadata_ts(p), count, args);
 }
 
 /*----------------------------------------------------------------------------*/
