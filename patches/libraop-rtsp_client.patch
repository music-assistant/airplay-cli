 	char *req;
@@ -576,6 +598,9 @@ static bool exec_request(struct rtspcl_s *rtspcld, char *cmd, char *content_type
 	i = poll(&pfds, 1, 0);
 	if (i == -1 || (pfds.revents & POLLERR) || (pfds.revents & POLLHUP)) return false;
 
+	// a connection closed by the peer alone passes the poll above, yet no answer can come on it
+	if (recv(rtspcld->fd, buf, 1, MSG_PEEK | MSG_DONTWAIT) == 0) return false;
+
 	if ((req = malloc(4096+length)) == NULL) return false;
 
