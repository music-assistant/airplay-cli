+	if (!tcp_connect_by_host(p->fd, host, destport)) {
+		closesocket(p->fd);
+		p->fd = -1;
+		return false;
+	}
 
 	struct sockaddr_in name;
 	socklen_t namelen = sizeof(name);
@@ -136,6 +157,7 @@ bool rtspcl_destroy(struct rtspcl_s *p) {
 	if (!p) return false;
 
 	bool rc = rtspcl_disconnect(p);
+	pthread_mutex_destroy(&p->mutex);
 	free(p);
 
 	return rc;
